{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suttastudyguide.local/schema/pali-personhood/0.1",
  "title": "Pali personhood process contract",
  "type": "object",
  "required": ["schema_version", "trace_kind", "model_version", "seed", "scenario", "agents", "streams", "observable_edges"],
  "properties": {
    "schema_version": {"const": "pali-personhood/0.1"},
    "trace_kind": {"enum": ["EpisodeTrace", "InteractionTrace"]},
    "model_version": {"enum": ["pali-canonical/v1", "theravada-synthesis/v1"]},
    "seed": {"type": "string"},
    "scenario": {"$ref": "#/$defs/Scenario"},
    "agents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/AgentProfile"}},
    "streams": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/AgentStream"}},
    "observable_edges": {"type": "array", "items": {"$ref": "#/$defs/ObservableEdge"}},
    "rounds": {"type": "array", "items": {"type": "object"}},
    "interaction_limits": {"$ref": "#/$defs/InteractionLimits"},
    "forbidden_claims": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "Scenario": {
      "type": "object", "required": ["id", "primary_object"],
      "properties": {
        "id": {"type": "string"}, "title": {"type": "string"}, "description": {"type": "string"},
        "primary_object": {"type": "object", "required": ["id", "door", "valence", "observable"], "properties": {
          "id": {"type": "string"}, "kind": {"type": "string"}, "value": {},
          "door": {"enum": ["eye", "ear", "nose", "tongue", "body", "mind"]},
          "valence": {"enum": ["pleasant", "painful", "neutral"]}, "observable": {"type": "boolean"},
          "source_agent_id": {"type": ["string", "null"]}
        }},
        "observations": {"type": "array", "maxItems": 6, "items": {"type": "object", "required": ["id", "door", "valence", "observable"], "properties": {
          "id": {"type": "string"}, "kind": {"type": "string"}, "value": {},
          "door": {"enum": ["eye", "ear", "nose", "tongue", "body", "mind"]},
          "valence": {"enum": ["pleasant", "painful", "neutral"]}, "observable": {"type": "boolean"},
          "source_agent_id": {"type": ["string", "null"]}
        }}},
        "max_rounds": {"type": "integer", "minimum": 1, "maximum": 6}
      }
    },
    "AgentProfile": {
      "type": "object", "required": ["id", "species", "tendencies", "training"],
      "properties": {
        "id": {"type": "string"}, "label": {"type": "string"}, "species": {"enum": ["human", "animal", "unknown"]},
        "tendencies": {"$ref": "#/$defs/BoundedTraits"}, "training": {"$ref": "#/$defs/BoundedTraits"}
      }
    },
    "BoundedTraits": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
    "AgentStream": {
      "type": "object", "required": ["agent_id", "events", "branch"],
      "properties": {"agent_id": {"type": "string"}, "branch": {"enum": ["trained", "untrained"]}, "events": {"type": "array", "items": {"$ref": "#/$defs/TraceEvent"}}}
    },
    "TraceEvent": {
      "type": "object", "required": ["id", "actor_id", "kind", "phase", "conditions", "aggregates", "evidence_ids"],
      "properties": {
        "id": {"type": "string"}, "actor_id": {"type": "string"}, "step": {"type": "integer"}, "kind": {"type": "string"}, "phase": {"type": "string"},
        "conditions": {"type": "object"}, "aggregates": {"type": "object"}, "action": {}, "branch": {"type": ["string", "null"]},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "uncertainty": {"type": ["string", "null"]}
      }
    },
    "ObservableEdge": {
      "type": "object", "required": ["from_agent_id", "to_agent_id", "source_event_id", "accessible_state"],
      "properties": {"from_agent_id": {"type": "string"}, "to_agent_id": {"type": "string"}, "source_event_id": {"type": "string"}, "accessible_state": {"const": "observable-action-only"}}
    }
    ,"InteractionLimits": {
      "type": "object", "required": ["max_rounds", "rounds_completed", "private_state_shared"],
      "properties": {"max_rounds": {"type": "integer"}, "rounds_completed": {"type": "integer"}, "private_state_shared": {"const": false}}
    }
  }
}
